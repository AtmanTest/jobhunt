{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Offer (table Supabase offers — modèle d'ingestion WF1)",
  "type": "object",
  "required": [
    "external_id",
    "source",
    "title",
    "url"
  ],
  "properties": {
    "external_id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "company": {
      "type": [
        "string",
        "null"
      ]
    },
    "location": {
      "type": [
        "string",
        "null"
      ]
    },
    "remote": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "contract": {
      "type": [
        "string",
        "null"
      ]
    },
    "salary": {
      "type": [
        "string",
        "null"
      ]
    },
    "url": {
      "type": "string",
      "pattern": "^https?://"
    },
    "published_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "score": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "tags": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
